{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\path\\to\\traffic-light-indicator\\codex_status_hook.py\" --event SessionStart",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -File \"C:\\path\\to\\traffic-light-indicator\\invoke-status-hook.ps1\" -PythonPath \"C:\\path\\to\\python.exe\" -EventName SessionStart",
            "timeout": 5,
            "statusMessage": "Update traffic light indicator"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\path\\to\\traffic-light-indicator\\codex_status_hook.py\" --event UserPromptSubmit",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -File \"C:\\path\\to\\traffic-light-indicator\\invoke-status-hook.ps1\" -PythonPath \"C:\\path\\to\\python.exe\" -EventName UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "Update traffic light indicator"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\path\\to\\traffic-light-indicator\\codex_status_hook.py\" --event PreToolUse",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -File \"C:\\path\\to\\traffic-light-indicator\\invoke-status-hook.ps1\" -PythonPath \"C:\\path\\to\\python.exe\" -EventName PreToolUse",
            "timeout": 5,
            "statusMessage": "Update traffic light indicator"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\path\\to\\traffic-light-indicator\\codex_status_hook.py\" --event PostToolUse",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -File \"C:\\path\\to\\traffic-light-indicator\\invoke-status-hook.ps1\" -PythonPath \"C:\\path\\to\\python.exe\" -EventName PostToolUse",
            "timeout": 5,
            "statusMessage": "Update traffic light indicator"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\path\\to\\traffic-light-indicator\\codex_status_hook.py\" --event PermissionRequest",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -File \"C:\\path\\to\\traffic-light-indicator\\invoke-status-hook.ps1\" -PythonPath \"C:\\path\\to\\python.exe\" -EventName PermissionRequest",
            "timeout": 5,
            "statusMessage": "Update traffic light indicator"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\path\\to\\traffic-light-indicator\\codex_status_hook.py\" --event Stop",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -File \"C:\\path\\to\\traffic-light-indicator\\invoke-status-hook.ps1\" -PythonPath \"C:\\path\\to\\python.exe\" -EventName Stop",
            "timeout": 5,
            "statusMessage": "Update traffic light indicator"
          }
        ]
      }
    ]
  }
}
